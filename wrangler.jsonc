{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alderlux-booking",
  "main": "src/worker.ts",
  "compatibility_date": "2025-10-01",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "alderlux-booking",
      // Replace with the real ID from `wrangler d1 create alderlux-booking` at deploy time.
      "database_id": "4a221952-2b04-4d23-aedb-63d9e45a15e4",
      "migrations_dir": "migrations"
    }
  ],
  // Reminder emails: every 30 minutes, send for calls starting within 24 hours.
  "triggers": { "crons": ["*/30 * * * *"] },
  "vars": { "TENANT": "alderlux", "SMTP_HOST": "mail.privateemail.com", "SMTP_PORT": "465", "SMTP_SECURE": "on", "SMTP_USER": "admin@alderlux.com", "PUBLIC_BASE_URL": "https://alderlux-booking.rob-h-masons.workers.dev" },
  // Emails go from admin@alderlux.com via Namecheap Private Email (SMTP, port 465). Outlook is used for
  // the calendar only. Secrets: SMTP_PASS, MS_CLIENT_ID, MS_CLIENT_SECRET, ADMIN_KEY (see README).
  "observability": { "enabled": true }
}
